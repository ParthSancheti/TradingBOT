# Copy locally; never commit real values. Admin authentication requires trusted HTTPS.
JARVIS_ENVIRONMENT=development
JARVIS_PUBLIC_ORIGIN=http://127.0.0.1:8765
JARVIS_DATABASE_URL=sqlite+pysqlite:///.runtime/control.sqlite3
# Exact issuer, immutable subject and accepted MFA/passkey assurance contexts.
# No first-user-admin registration and no built-in development login.
JARVIS_OIDC_ISSUER=
JARVIS_OIDC_CLIENT_ID=
JARVIS_OIDC_CLIENT_SECRET=
JARVIS_ADMIN_SUBJECT=
JARVIS_ACCEPTED_ACR=[]
JARVIS_DATABASE_AUTO_CREATE=true
# This database is for security sessions/limits only. Business records use Google Sheets.
# Production: trusted HTTPS, explicit schema initialization, migrations and an IdP policy.
# Provider and bridge secrets are enrolled in the OS vault through protected setup.

